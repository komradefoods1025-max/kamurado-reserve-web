# Google Apps Script Web App deployment URL
# Replace XXXXXXXXXXXX with your deployed Web App ID.
# /exec まで（?action=... は付けない）。両方同じ URL に揃える
# サーバー API は RESERVATION_SAVE_URL を優先（NEXT_PUBLIC だけ古いと保存失敗しやすい）
RESERVATION_SAVE_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
NEXT_PUBLIC_RESERVATION_SAVE_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Legacy fallback (optional)
# NEXT_PUBLIC_WEB_RESERVATION_ENDPOINT=

# Optional: set to true to show phone-only maintenance (LINE + web)
# RESERVATION_MAINTENANCE=true
# NEXT_PUBLIC_RESERVATION_MAINTENANCE=true

# 店内オーダー /order テスト（休業日・開店前・22:00/22:30 LO を無視）
# NEXT_PUBLIC_STORE_ORDER_TEST_MODE=true
# STORE_ORDER_TEST_MODE=true
# 本番でラストオーダー（22:00/22:30）を効かせるときだけ:
# STORE_ORDER_ENFORCE_LAST_ORDER=true
# NEXT_PUBLIC_STORE_ORDER_ENFORCE_LAST_ORDER=true

# 店内オーダーの保存先（店内デフォルト: display_only＝スプシ・LINEなし、店舗画面のみ）
# STORE_ORDER_SAVE_MODE=display_only
# STORE_ORDER_SAVE_MODE=both
# STORE_ORDER_SAVE_MODE=gas

# 店内飲食モード（デフォルト ON）。持ち帰りに戻す場合:
# STORE_ORDER_DINE_IN=false
# NEXT_PUBLIC_STORE_ORDER_DINE_IN=false
# NEXT_PUBLIC_STORE_ORDER_PICKUP=true

# 店舗表示（キッチン iPad / レジ iPhone）— Upstash Redis REST
# STORE_DISPLAY_PIN=（4〜8桁など）
# STORE_DISPLAY_SESSION_SECRET=（任意・未設定時は PIN を秘密鍵に利用）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Redis なしの暫定テスト（Vercel では不安定。Upstash 推奨）:
# STORE_ORDER_TEST_MODE=true
# STORE_ORDER_DISPLAY_MEMORY_FALLBACK=true

# Web 臨時休業: GAS getClosedDays（スプシ closed_days）— 上記 URL と同じデプロイが必要
# Optional: Web-only save when main GAS still has old date rules (deploy gas/WebSaveMinimal.gs)
# RESERVATION_SAVE_FALLBACK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
# NEXT_PUBLIC_RESERVATION_SAVE_FALLBACK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
